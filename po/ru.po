#: tracepath.c:605
#, c-format
msgid ""
"\n"
"Usage\n"
"  tracepath [options] <destination>\n"
"\n"
"Options:\n"
"  -4             use IPv4\n"
"  -6             use IPv6\n"
"  -b             print both name and IP\n"
"  -l <length>    use packet <length>\n"
"  -m <hops>      use maximum <hops>\n"
"  -n             no reverse DNS name resolution\n"
"  -p <port>      use destination <port>\n"
"  -e             show ICMP extensions (if present)\n"
"  -V             print version and exit\n"
"  <destination>  DNS name or IP address\n"
"\n"
"For more details see tracepath(8).\n"
msgstr ""
"\n"
"Использование\n"
"  tracepath [параметры] <назначение>\n"
"\n"
"Параметры:\n"
"  -4             использовать IPv4\n"
"  -6             использовать IPv6\n"
"  -b             выводить и имя, и IP\n"
"  -l <длина>     использовать пакет <длины>\n"
"  -m <переходы>  использовать максимум <переходов>\n"
"  -n             без обратного DNS-разрешения имён\n"
"  -p <порт>      использовать порт назначения <порт>\n"
"  -e             показывать расширения ICMP (если присутствуют)\n"
"  -V             вывести версию и выйти\n"
"  <назначение>   DNS-имя или IP-адрес\n"
"\n"
"Подробнее см. tracepath(8).\n"

#: tracepath.c:664 tracepath.c:669
msgid "Only one -4 or -6 option may be specified"
msgstr "Может быть указан только один параметр -4 или -6"

